(answer-shape "psycho_bench" "indexed_mapping_lines")
(summary "psycho_bench" "Exact plain-text lines in the form `index: score`, integer scores only, and no wrapper prose.")
(constraint "psycho_bench" "emit only `index: score` lines")
(constraint "psycho_bench" "scores must be integers in the range 1 to 5")
(forbid "psycho_bench" "bullets, wrappers, or commentary")
(minimal-example "psycho_bench" "31: 2\n39: 3")
(example-status "psycho_bench" "validated_minimal_example")

(answer-shape "ascii_tree" "ascii_formatted_tree")
(summary "ascii_tree" "Exact ASCII tree structure wrapped in <ascii_formatted> tags with no surrounding prose.")
(constraint "ascii_tree" "wrap answer in <ascii_formatted> tags")
(constraint "ascii_tree" "preserve a valid ASCII tree branch structure")
(forbid "ascii_tree" "markdown fences or malformed closing tags")
(minimal-example "ascii_tree" "<ascii_formatted>\nmain\n `--child\n</ascii_formatted>")
(example-status "ascii_tree" "validated_minimal_example")

(answer-shape "pydantic_adherence" "strict_json_object")
(summary "pydantic_adherence" "Return one JSON object compatible with the provided pydantic model and nothing else. The live community verifier extracts the last JSON object and validates it with JSON-native semantics via `model_validate_json(..., strict=False)`.")
(constraint "pydantic_adherence" "return one JSON object and nothing else")
(constraint "pydantic_adherence" "cooldown must use integer day counts or numeric strings")
(validation-path "pydantic_adherence" "extract_last_json -> json.dumps(parsed_dict) -> model.model_validate_json(serialized_payload, strict=False)")
(validator-note "pydantic_adherence" "period genres must be unique")
(validator-note "pydantic_adherence" "reference genre cannot exceed 7 days")
(validator-note "pydantic_adherence" "fine_policy.max_total must be greater than or equal to fine_policy.per_day")
(validator-note "pydantic_adherence" "renewal_policy.cooldown accepts integer day counts or numeric strings before timedelta coercion")
(validator-note "pydantic_adherence" "the live scorer validates JSON-native payloads with model_validate_json(..., strict=False)")
(minimal-example "pydantic_adherence" "{\"policy_id\":\"11111111-1111-1111-1111-111111111111\",\"name\":\"Main\",\"max_books\":3,\"periods\":[],\"fine_policy\":{\"per_day\":1.0,\"max_total\":5.0},\"renewal_policy\":{\"max_renewals\":1,\"cooldown\":\"1\"},\"exceptions\":{},\"created_at\":\"2026-01-01T00:00:00\"}")
(example-status "pydantic_adherence" "validated_minimal_example")
