(failure-mode "psycho_bench" "refusal text instead of numbered lines")
(failure-mode "psycho_bench" "extra commentary around scores")
(failure-mode "psycho_bench" "non-integer values or out-of-range scores")
(repair-hint "psycho_bench" "strip all prose and emit only numbered score lines")
(trace-label "psycho_bench" "schema_drift")

(failure-mode "ascii_tree" "missing closing </ascii_formatted> tag")
(failure-mode "ascii_tree" "extra prose before or after the tree")
(failure-mode "ascii_tree" "markdown fence leaked into final answer")
(failure-mode "ascii_tree" "wrong branch glyphs or unstable indentation")
(repair-hint "ascii_tree" "close with </ascii_formatted> and remove markdown fences")
(trace-label "ascii_tree" "wrapper_failure")

(failure-mode "pydantic_adherence" "empty output or fallback action")
(failure-mode "pydantic_adherence" "markdown fences around JSON")
(failure-mode "pydantic_adherence" "cooldown supplied as natural language instead of integer day count")
(failure-mode "pydantic_adherence" "schema-violating field types or missing required keys")
(verifier-caveat "pydantic_adherence" "historical note: before 2026-04-22, the live scorer validated the parsed Python dict directly and made UUID/datetime fields unsatisfiable from plain JSON")
(repair-hint "pydantic_adherence" "coerce cooldown to integer day count and re-check required fields")
(trace-label "pydantic_adherence" "validator_failure")
