(answer-shape "if_summarize_judge" "constraint_conditioned_summary")
(summary "if_summarize_judge" "Infer the requested structural family from the instruction, then emit only a structure-conforming summary with no extra prose.")
(constraint "if_summarize_judge" "classify the active constraint family before writing the answer")
(constraint "if_summarize_judge" "satisfy exact counts, delimiters, wrappers, and casing literally")
(constraint "if_summarize_judge" "emit only the constrained summary text")
(forbid "if_summarize_judge" "prefaces, explanations, or code fences")
(forbid "if_summarize_judge" "extra lines outside the requested family")
(validation-path "if_summarize_judge" "infer constraint family from observation -> enforce exact structural rules -> remote judge checks compliance and is lenient on content quality")
(validator-note "if_summarize_judge" "the judge is strict on structure and lenient on content quality")
(validator-note "if_summarize_judge" "exactly N means exact word, sentence, bullet, or hashtag counts")
(validator-note "if_summarize_judge" "or fewer means less than or equal to the stated limit")
(minimal-example "if_summarize_judge" "Welschbillig Castle rose over Roman remains, and later wars left it a ruin.")
(example-status "if_summarize_judge" "validated_minimal_example")
